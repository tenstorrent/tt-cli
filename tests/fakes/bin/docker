#!/usr/bin/env python3
"""Fake `docker` for tests: serves canned `ps`/`inspect` data and records `stop`s.

FAKE_DOCKER_CONTAINERS is a JSON list of inspect records in the shape tt reads:
Id/Name/Config.Image/Config.Labels/Mounts/State/HostConfig.PortBindings/
NetworkSettings.Ports/Labels/Ports — the last a raw `docker ps --format {{.Ports}}`
string, e.g. "0.0.0.0:20000->20000/tcp". `ps` lists running records only — one with
no State at all counts as running — unless --all/-a is passed, like the real thing;
--filter label=… narrows by top-level Labels, `--format {{.Ports}}` prints the Ports
string, everything else prints one 12-char id per line (what tt asks for).
FAKE_DOCKER_STOP_LOG collects stopped ids.
"""

import json
import os
import sys


def _containers() -> list:
    return json.loads(os.environ.get("FAKE_DOCKER_CONTAINERS") or "[]")


def _label_filter(args: list) -> str | None:
    for a in args:
        if a.startswith("label="):
            return a[len("label="):]
    return None


def main() -> int:
    args = sys.argv[1:]
    if args[:1] == ["ps"]:
        label = _label_filter(args)
        show_all = bool({"--all", "-a"} & set(args[1:]))
        entries = _containers()
        if label is not None:
            entries = [e for e in entries if label in (e.get("Labels") or {})]
        if not show_all:
            entries = [
                e for e in entries
                if e.get("State") is None or e["State"].get("Running")
            ]
        if "{{.Ports}}" in args:
            for entry in entries:
                print(entry.get("Ports", ""))
            return 0
        for entry in entries:
            print(str(entry.get("Id", ""))[:12])
        return 0
    if args[:1] == ["inspect"]:
        # `--format {{json .}}` is an option value, so only bare ids are targets
        wanted = [a for a in args[1:] if not a.startswith("-") and not a.startswith("{{")]
        for entry in _containers():
            if str(entry.get("Id", ""))[:12] in wanted:
                print(json.dumps(entry))
        return 0
    if args[:1] == ["stop"]:
        log = os.environ.get("FAKE_DOCKER_STOP_LOG")
        if log:
            with open(log, "a") as fh:
                for target in args[1:]:
                    fh.write(target + "\n")
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
