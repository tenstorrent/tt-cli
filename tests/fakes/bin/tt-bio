#!/usr/bin/env python3
"""Fake `tt-bio` for tests: records argv and the chip grant it inherited, then exits.

Never opens a device or touches the network. FAKE_TT_BIO_LOG collects one JSON line
per invocation with the argv and TT_BIO_LEASE_CARDS, which is what the tests assert
on: tt's whole job here is handing the right chips to the right run.
FAKE_TT_BIO_EXIT forces a non-zero exit code.
"""

import json
import os
import sys


def main() -> int:
    argv = sys.argv[1:]
    log = os.environ.get("FAKE_TT_BIO_LOG")
    if log:
        with open(log, "a") as fh:
            fh.write(
                json.dumps(
                    {
                        "argv": argv,
                        "lease_cards": os.environ.get("TT_BIO_LEASE_CARDS"),
                    }
                )
                + "\n"
            )
    if argv[:1] == ["--version"]:
        print("tt-bio, version 0.37.0")
        return 0
    return int(os.environ.get("FAKE_TT_BIO_EXIT") or 0)


if __name__ == "__main__":
    sys.exit(main())
